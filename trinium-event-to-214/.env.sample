# 214 service (reads driver-app updates, writes EDI 214 files)
EVENTS_BASE_DIR=./events          # dev input: drop event JSON in events/input (same payloads as the Kafka topic)
EDI_OUT_DIR=./edi214/outbound     # generated 214 files
POLL_INTERVAL_MS=5000
EDI_STABLE_MS=1000

# Same database as the order service (needs trinium_legs / trinium_leg_stops).
# Embedded PGlite allows ONE process at a time (lock file) - stop the order service first, or set PGHOST for shared Postgres.
DB_DIR=../trinium-order-transformer/data/pglite

# ---- Kafka consumer ----
KAFKA_ENABLED=false
KAFKA_UPDATE_TOPIC=msk.driverapp.updates.topic.internal.any.v2
KAFKA_GROUP_ID=msk.driverapp.updates.internal.consumergroup.cdt.v2
KAFKA_FROM_BEGINNING=false
KAFKA_DUMP_DIR=./events/received   # raw copy of every message read from the topic (empty = off)
KAFKA_BROKERS=emp-ehub-dedicated-pp-we-1-kafka.maersk-digital.net:443
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=true
# KAFKA_TRUSTSTORE_P12=./certs/dedicated-decode.p12
# KAFKA_TRUSTSTORE_PASSWORD=
# or a PEM:  KAFKA_CA_FILE=./certs/ca.pem
KAFKA_CLIENT_ID=driverapp-updates-processor-trinium214

# ---- 214 envelope: DrayApp mode (the existing DrayApp -> Trinium 214 format, verified against 2,165 real files) ----
EDI_PROFILE=DRAYAPP               # DRAYAPP (default) | OALM (the older OALM sample format)
ISA_SENDER_ID=HDDR                # decision D2: replace with the new trading-partner id once provisioned
ISA_RECEIVER_ID=HDDR
B10_SCAC=HDDR
# Control numbers: our own range, far above the existing DrayApp stream (~4.45 million, +1 each) and a different step so they never collide.
EDI_CONTROL_START=50000000
EDI_CONTROL_STEP=7
L11_TO_MODE=from204               # DrayApp 214 TO == 204 TO
ENABLE_APPOINTMENT_214=false      # AA/AB are dispatcher-sourced, not app events
SEND_XB=true                      # driver Accept -> XB

PORT=8081
METRICS_PORT=44421

# ---- Postgres (udapdb001). Set PGHOST to use it; both services share this database ----
# PGHOST=10.0.8.4
# PGPORT=5036
# PGDATABASE=udapdb001
# PGUSER=
# PGPASSWORD=
# PGSCHEMA=udapdb001
# PGSSLMODE=require              # disable | require (encrypted, not verified) | verify-full (+ PGSSL_CA_FILE)
# PG_POOL_MAX=10                 # connections per instance; keep (instances x max x 2 services) below the server limit
# PG_POOL_MIN=1
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_MAX_LIFETIME_S=1800         # recycle connections (picks up failovers)
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_LOCK_TIMEOUT_MS=10000
# PG_IDLE_TX_TIMEOUT_MS=60000
# DB_RETRY_MAX=5                 # attempts for transient errors (connect, deadlock, serialization, failover), exponential backoff + jitter
# DB_RETRY_BASE_MS=200
# DB_RETRY_MAX_MS=5000
# DB_MIGRATE=true                # false = do not apply schema.sql on start (run `npm run migrate` as a release step instead)
# REF_REFRESH_MS=300000          # reload state time zones / event code map from the database
# GEO_REFRESH_MS=300000          # (order service) reload ref_geo_location when the table changed
# GEO_MAX_REMOVE_PCT=30          # (order service) refuse a geo load that would remove more than this share of the table
