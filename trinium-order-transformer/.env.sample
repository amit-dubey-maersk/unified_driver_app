# ---- Folders (local stand-in for the Trinium SFTP 204 folder) ----
EDI_BASE_DIR=./edi            # creates input/ processed/ archive/ error/ under it
POLL_INTERVAL_MS=5000
EDI_STABLE_MS=1000            # ignore files modified in the last N ms (still being written)

# ---- Geo dataset: lives in table ref_geo_location; this CSV only seeds an EMPTY table (or `npm run load-geo -- file.csv`) ----
GEO_CSV_PATH=./data/Geo.csv

# ---- Database ----
# Leave PG* unset  -> embedded Postgres-compatible DB (PGlite) persisted in DB_DIR (local dev)
# Set PGHOST       -> MDP Postgres (same variables as the reference service)
DB_DIR=./data/pglite

# ---- Kafka (retina-kafka) ----
KAFKA_ENABLED=false           # false = everything is still processed + stored; messages wait as PENDING in outbound_messages
KAFKA_TOPIC=                  # <-- target topic for mobile-backend orders (not yet provided)
KAFKA_BROKERS=emp-ehub-dedicated-pp-we-1-kafka.maersk-digital.net:443
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=true
# kafkajs needs PEM. Convert the truststore once:
#   openssl pkcs12 -in dedicated-decode.p12 -nokey -out ca.pem -passin pass:<truststore password>
KAFKA_CA_FILE=./certs/ca.pem
KAFKA_CLIENT_ID=trinium-order-transformer

# ---- Ports ----
PORT=8080
METRICS_PORT=44420

# ---- Postgres (udapdb001). Set PGHOST to use it; both services share this database ----
# PGHOST=10.0.8.4
# PGPORT=5036
# PGDATABASE=udapdb001
# PGUSER=
# PGPASSWORD=
# PGSCHEMA=udapdb001
# PGSSLMODE=require              # disable | require (encrypted, not verified) | verify-full (+ PGSSL_CA_FILE)
# PG_POOL_MAX=10                 # connections per instance; keep (instances x max x 2 services) below the server limit
# PG_POOL_MIN=1
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_MAX_LIFETIME_S=1800         # recycle connections (picks up failovers)
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_LOCK_TIMEOUT_MS=10000
# PG_IDLE_TX_TIMEOUT_MS=60000
# DB_RETRY_MAX=5                 # attempts for transient errors (connect, deadlock, serialization, failover), exponential backoff + jitter
# DB_RETRY_BASE_MS=200
# DB_RETRY_MAX_MS=5000
# DB_MIGRATE=true                # false = do not apply schema.sql on start (run `npm run migrate` as a release step instead)
# REF_REFRESH_MS=300000          # reload state time zones / event code map from the database
# GEO_REFRESH_MS=300000          # (order service) reload ref_geo_location when the table changed
# GEO_MAX_REMOVE_PCT=30          # (order service) refuse a geo load that would remove more than this share of the table
