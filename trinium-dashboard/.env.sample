# Dashboard: read-only view over the shared database, trace logs and the Trinium SFTP
PORT=8090
HOST=127.0.0.1                 # loopback only: no login on this page. Use 0.0.0.0 only behind your own auth/network control

# ---- Same Postgres as both services (sessions are forced read-only) ----
PGHOST=10.0.8.4
PGPORT=5036
PGDATABASE=udapdb001
PGUSER=
PGPASSWORD=
PGSCHEMA=udapdb001
PGSSLMODE=require

# ---- Files the services write (relative to this folder) ----
ORDER_LOG_DIR=../trinium-order-transformer/logs
EVENT_LOG_DIR=../trinium-event-to-214/logs
ORDER_EDI_DIR=../trinium-order-transformer/edi
EVENTS_DIR=../trinium-event-to-214/events
EDI214_DIR=../trinium-event-to-214/edi214/outbound

# ---- Live SFTP folder view (read-only listing) ----
DASH_SFTP=true
SFTP_HOST=sftpus2.triniumtech.com
SFTP_PORT=40122
SFTP_USERNAME=sftp-damc-amit
SFTP_PRIVATE_KEY_FILE=../pubkey002          # or SFTP_PRIVATE_KEY=<PEM text> for container secrets
SFTP_HOST_KEY_SHA256=
SFTP_204_IN_DIR=204out
SFTP_204_ARCHIVE_DIR=204archive
SFTP_214_OUT_DIR=214in                        # CONFIRM with Trinium: 214s go to 214in (204out is where THEY publish 204s)
CACHE_TTL_MS=5000
